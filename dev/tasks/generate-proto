set -o nounset
set -o pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "${REPO_ROOT}"

go run github.com/gke-labs/gke-labs-infra/ap@latest tool protoc \
  -I. \
  --go_out=. --go_opt=module=github.com/gke-labs/in-cluster-storage \
  --go-grpc_out=. --go-grpc_opt=module=github.com/gke-labs/in-cluster-storage \
  proto/*.proto
